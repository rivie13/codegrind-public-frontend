# CodeGrind Frontend Environment Variables

# ===========================================
# API CONFIGURATION
# ===========================================
VITE_API_URL=http://localhost:3000
VITE_AI_SERVER_URL=http://localhost:3000
VITE_JUDGE0_API_URL=https://your-judge0-instance.azurecontainer.io:2358
VITE_DISCORD_OAUTH_START_URL=http://localhost:5173/api/discord/oauth/start

# ===========================================
# AZURE CONFIGURATION
# ===========================================
VITE_USE_AZURE=true
VITE_NODE_ENV=development

# ===========================================
# GOOGLE ADSENSE (Optional)
# ===========================================
VITE_GOOGLE_ADSENSE_ID=ca-pub-your-adsense-id-here

# ===========================================
# ENVIRONMENT
# ===========================================
VITE_ENVIRONMENT=development

# ===========================================
# ASSET BASE URL (Optional)
# ===========================================
# Example: https://res.cloudinary.com/your-cloudinary-cloud-name/image/upload
# Leave empty for local dev assets
VITE_ASSET_BASE_URL=

# ===========================================
# SOUND BASE URL (Optional)
# ===========================================
# Example: https://res.cloudinary.com/your-cloudinary-cloud-name/video/upload
# Leave empty for local dev sounds
VITE_SOUND_BASE_URL=

# ===========================================
# Version Info
# ===========================================
VITE_SITE_VERSION=1.5.0


# ===========================================
# RECAPTCHA CONFIGURATION
# ===========================================
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
