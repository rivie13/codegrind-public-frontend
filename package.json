{
  "name": "codegrind-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "mcp:tiled:install": "npm --prefix ./tools/tiled-mcp-server install",
    "mcp:tiled:build": "npm --prefix ./tools/tiled-mcp-server run build",
    "mcp:tiled:dev": "npm --prefix ./tools/tiled-mcp-server run dev",
    "tiled:asset:inspect": "node scripts/tiled-assets/inspect-png.mjs",
    "tiled:asset:sheet": "node scripts/tiled-assets/write-sheet-tileset.mjs",
    "tiled:asset:collection": "node scripts/tiled-assets/write-collection-tileset.mjs",
    "tiled:map:attach-tileset": "node scripts/tiled-assets/attach-tileset-to-map.mjs",
    "tiled:asset:prep": "node scripts/tiled-assets/prepare-from-manifest.mjs",
    "tiled:asset:prep:d01-apartment": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/district-01-apartment-supplemental-assets.json",
    "tiled:asset:prep:d01-modern-interiors-16x16": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/district-01-modern-interiors-16x16.json",
    "tiled:asset:prep:d01-sign-1-open": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/district-01-sign-1-open.json",
    "tiled:asset:prep:d01-sign-pack": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/district-01-sign-pack.json",
    "tiled:asset:prep:pixel-edge-city-exteriors": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-exteriors.json",
    "tiled:asset:prep:pixel-edge-city-collections": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-collections-fixed.json",
    "tiled:asset:prep:pixel-edge-city-street-vendors-refined": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-street-vendors-refined.json",
    "tiled:asset:prep:pixel-edge-city-vehicles-refined": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-vehicles-refined.json",
    "tiled:asset:prep:pixel-edge-city-objects-refined": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-objects-refined.json",
    "tiled:asset:prep:pixel-edge-city-machinery-refined": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-machinery-refined.json",
    "tiled:asset:prep:pixel-edge-city-premade-buildings-refined": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/pixel-edge-city-premade-buildings-refined.json",
    "tiled:asset:prep:city-v2-library": "node scripts/tiled-assets/prepare-from-manifest.mjs --manifest scripts/tiled-assets/manifests/city-v2-library-assets.json",
    "runtime:coverage": "node scripts/capture-runtime-coverage.mjs",
    "fallow:health:runtime": "npx fallow health --runtime-coverage coverage/runtime/runtime-coverage-final.json --format json --summary",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/image": "^2.1.0",
    "@chakra-ui/react": "^2.10.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^6.3.0",
    "@rivie13/premium-core": "^1.1.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "apt": "^0.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dompurify": "^3.2.6",
    "framer-motion": "^10.18.0",
    "jsonwebtoken": "^9.0.2",
    "phaser": "^3.90.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.3.0",
    "re-resizable": "^6.10.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^9.0.1",
    "react-resizable": "^3.0.5",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.16.0",
    "remark-gfm": "^4.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fallow-cli/fallow-cov": "^0.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.1",
    "playwright": "^1.55.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^6.2.3",
    "vite-prerender-plugin": "^0.5.13",
    "vitest": "^4.0.18"
  }
}
